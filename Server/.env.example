# Copy this file to .env and fill in real values before running locally.
# Production secrets are injected via `fly secrets set` or Render environment variables.
# Never commit the real .env file — it is listed in .gitignore.

# ── Database ────────────────────────────────────────────────────────────────
# Standard PostgreSQL connection URL.
# The default below matches docker-compose.yml for local development.
DATABASE_URL=postgres://calmframe:calmframe@localhost:5432/calmframe

# ── JWT ─────────────────────────────────────────────────────────────────────
# Secret used to sign server-issued JWTs. Generate a strong value with:
#   openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret

# ── Apple ───────────────────────────────────────────────────────────────────
# Bundle ID registered in App Store Connect (must match the iOS app target).
APPLE_BUNDLE_ID=com.example.calmframe
# Numeric App ID from App Store Connect → App Information.
APPLE_APP_ID=1234567890
# 10-character Team ID from developer.apple.com.
APPLE_TEAM_ID=ABCDE12345

# ── AI providers ────────────────────────────────────────────────────────────
# Which image provider to use: fake | seedream
# Use "fake" for local development and tests — returns a deterministic
# 1x1 PNG, no API call. "seedream" calls Volcano Ark (doubao-seedream-5-5-261028)
# and is not yet implemented in this slice; choosing it fails at startup.
IMAGE_PROVIDER=fake
# Volcano Ark API key (same key for Seedream images and Doubao text).
IMAGE_API_KEY=replace-me
# Doubao text model for painting titles/captions (Ark chat completions).
# Verified from the Ark console 2026-11-19. Do not use a doubao-1-5 id —
# that series is not in the current console model list.
ARK_TEXT_MODEL=doubao-seed-2-0-mini-260428
# Fake provider only: when "true", FakeImageProvider throws instead of
# returning an image, so the refund path can be exercised end to end.
FAKE_IMAGE_FAIL=false

# ── Painting storage ────────────────────────────────────────────────────────
# Which storage backend to use: local | r2
# "local" writes to PAINTINGS_DIR and serves via /static/paintings/<key>
# (dev fallback only — disk is ephemeral on Fly/Render). "r2" is the deploy
# target and is not yet implemented; choosing it fails at startup.
STORAGE_BACKEND=local
# Directory for locally stored paintings, relative to the server working
# directory (or absolute). Not committed — see .gitignore.
PAINTINGS_DIR=paintings/
# Public origin used to build painting image URLs.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# ── Object storage (Cloudflare R2 or AWS S3) ────────────────────────────────
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=calm-frame
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
# Use "auto" for Cloudflare R2; use an AWS region code (e.g. us-east-1) for S3.
S3_REGION=auto

# ── App Store (StoreKit JWS verification) ───────────────────────────────────
# Environment for StoreKit JWS verification: sandbox | production
APP_STORE_ENVIRONMENT=sandbox
# Numeric App ID from App Store Connect (required in production; leave empty until the app record exists).
APP_STORE_APP_APPLE_ID=
