# Copy this file to .env and fill in real values before running locally.
# Production secrets are injected via `fly secrets set` or Render environment variables.
# Never commit the real .env file — it is listed in .gitignore.

# ── Database ────────────────────────────────────────────────────────────────
# Standard PostgreSQL connection URL.
# The default below matches docker-compose.yml for local development.
DATABASE_URL=postgres://calmframe:calmframe@localhost:5432/calmframe

# ── JWT ─────────────────────────────────────────────────────────────────────
# Secret used to sign server-issued JWTs. Generate a strong value with:
#   openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret

# ── Apple ───────────────────────────────────────────────────────────────────
# Bundle ID registered in App Store Connect (must match the iOS app target).
APPLE_BUNDLE_ID=com.example.calmframe
# Numeric App ID from App Store Connect → App Information.
APPLE_APP_ID=1234567890
# 10-character Team ID from developer.apple.com.
APPLE_TEAM_ID=ABCDE12345

# ── AI providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace-me
# Which image provider to use: openai | replicate | fake
# Use "fake" for local development — returns a placeholder image, no API call.
IMAGE_PROVIDER=fake
IMAGE_API_KEY=replace-me

# ── Object storage (Cloudflare R2 or AWS S3) ────────────────────────────────
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=calm-frame
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
# Use "auto" for Cloudflare R2; use an AWS region code (e.g. us-east-1) for S3.
S3_REGION=auto

# ── App Store (StoreKit JWS verification) ───────────────────────────────────
# Environment for StoreKit JWS verification: sandbox | production
APP_STORE_ENVIRONMENT=sandbox
# Numeric App ID from App Store Connect (required in production; leave empty until the app record exists).
APP_STORE_APP_APPLE_ID=
